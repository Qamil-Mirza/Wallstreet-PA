# News API Configuration
# Using MarketAux - free tier allows 3 articles per request
# Get your free API key at: https://www.marketaux.com/
NEWS_API_KEY=your_marketaux_api_key_here
NEWS_API_BASE_URL=https://api.marketaux.com/v1

# SMTP Configuration (Gmail example - use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
RECIPIENT_EMAIL=recipient@example.com

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# TTS Configuration (Coqui TTS)
# Generates audio broadcast from article summaries
# NOTE: Coqui TTS is licensed for non-commercial use only
TTS_ENABLED=true
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
# TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2  # High-quality multilingual
TTS_LANGUAGE=en  # Language code (required for XTTS models)
TTS_SPEAKER=Claribel Dervla  # Speaker name for XTTS (options: Claribel Dervla, Ana Florence, etc.)
TTS_SPEED=1.0  # Speech speed (1.0 = normal, 1.2 = 20% faster, 0.8 = 20% slower)
TTS_OUTPUT_DIR=audio_output
TTS_USE_CUDA=false
TTS_DURATION_MINUTES=2.0

# Section Feature Flags (true/false)
# Toggle which news sections to include in your newsletter
SECTION_WORLD_ENABLED=true
SECTION_US_TECH_ENABLED=true
SECTION_US_INDUSTRY_ENABLED=true
SECTION_MALAYSIA_TECH_ENABLED=true
SECTION_MALAYSIA_INDUSTRY_ENABLED=true

# RSS Feed Configuration (Optional)
# Add custom RSS/Atom feeds as additional news sources alongside MarketAux
# Feed names are automatically derived from the URL domain
RSS_ENABLED=true
# RSS_FEEDS=https://feeds.reuters.com/reuters/businessNews,https://feeds.bbci.co.uk/news/business/rss.xml

# Portfolio Research Configuration
# Research is opt-in; its files are derived beneath RESEARCH_DATA_DIR:
# research.db, cache/, reports/, and backups/.
RESEARCH_ENABLED=false
RESEARCH_DATA_DIR=research_data

# Read-only IBKR Flex credentials (read only for portfolio-backed commands)
IBKR_FLEX_TOKEN_FILE=/run/secrets/ibkr_flex_token
IBKR_FLEX_QUERY_ID_FILE=/run/secrets/ibkr_flex_query_id
# Mount a high-entropy account hashing salt of at least 16 bytes; never reuse a token.
IBKR_FLEX_ACCOUNT_SALT_FILE=/run/secrets/ibkr_flex_account_salt
IBKR_FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
IBKR_FLEX_POLL_TIMEOUT_SECONDS=120
PORTFOLIO_MAX_STALENESS_HOURS=24

# External inference is optional. Unset selects Ollama; unused commands skip this file.
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_RESEARCH_MODEL=llama3.1:8b
OLLAMA_HEALTH_TIMEOUT_SECONDS=60

# External model routes by specialist role
MODEL_ROUTE_RESEARCH_DIRECTOR=gpt-5.6-sol
MODEL_ROUTE_PORTFOLIO_MAPPER=gpt-5.6-terra
MODEL_ROUTE_EVENT_SCOUT=gpt-5.6-luna
MODEL_ROUTE_EMERGING_COMPANY_SCOUT=gpt-5.6-terra
MODEL_ROUTE_EVIDENCE_ANALYST=gpt-5.6-terra
MODEL_ROUTE_INDUSTRY_STRATEGIST=gpt-5.6-sol
MODEL_ROUTE_FUNDAMENTAL_ANALYST=gpt-5.6-sol
MODEL_ROUTE_SKEPTICAL_REVIEWER=gpt-5.6-sol
MODEL_ROUTE_RESEARCH_EDITOR=gpt-5.6-sol
MODEL_PRICE_EFFECTIVE_UNTIL=2026-12-31
MODEL_BUDGET_SOFT_USD=4.00
MODEL_BUDGET_HARD_USD=5.00

# Source freshness and regulatory-source identification
SOURCE_MAX_STALENESS_HOURS=168
SEC_USER_AGENT=PortfolioResearchBot/1.0 research@example.com

# APScheduler cron expressions (minute hour day-of-month month day-of-week)
RESEARCH_DAILY_SCHEDULE=0 7 * * mon-fri
RESEARCH_WEEKLY_SCHEDULE=0 8 * * mon
RESEARCH_MONTHLY_SCHEDULE=0 9 1 * *
RESEARCH_LANDSCAPE_SCHEDULE=0 10 1 */3 *
